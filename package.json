{
  "name": "youngkingz",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,cyan \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "pnpm --filter @youngkingz/web dev",
    "dev:api": "pnpm --filter @youngkingz/api dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "oxlint . --ignore-pattern artifacts/** --deny-warnings",
    "test": "vitest run",
    "test:unit": "vitest run tests/h01/unit",
    "test:integration": "vitest run tests/h01/integration",
    "test:h02:unit": "vitest run tests/h02/unit",
    "test:h02:integration": "vitest run tests/h02/integration",
    "test:e2e": "playwright test",
    "test:h02:e2e": "playwright test tests/h02/e2e",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop",
    "db:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reset-local-database.ps1",
    "db:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-database.ps1",
    "provision": "pnpm --filter @youngkingz/api cli:provision",
    "bootstrap:owner": "pnpm --filter @youngkingz/api cli:bootstrap-owner",
    "recovery:admin": "pnpm --filter @youngkingz/api cli:admin-recovery",
    "backup:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-restore-cert.ps1",
    "evidence": "tsx scripts/generate-evidence.ts",
    "h01:certify": "node scripts/h01-certify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^24.10.0",
    "@youngkingz/config": "workspace:*",
    "@youngkingz/contracts": "workspace:*",
    "@youngkingz/database": "workspace:*",
    "concurrently": "^9.2.1",
    "oxlint": "^1.90.0",
    "postgres": "^3.4.7",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
